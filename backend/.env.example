# ── Serveur ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de données ───────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/savora

# ── Sécurité ──────────────────────────────────────────────────────────────
# 32 caractères minimum. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplace-cette-valeur-par-une-cle-aleatoire-de-64-caracteres-minimum

# Liste blanche CORS, séparée par des virgules. Vide = toutes les origines
# (développement uniquement). Obligatoire lorsque NODE_ENV=production.
ORIGINES_AUTORISEES=

# ── Paiement ──────────────────────────────────────────────────────────────
# Facultatif. Sans clé, le paiement fonctionne en mode « simulation » hors ligne.
# Avec une clé de test (sk_test_...), le serveur crée de vrais PaymentIntents
# Stripe en mode test. Une clé live (sk_live_...) est refusée au démarrage.
STRIPE_SECRET_KEY=
STRIPE_DEVISE=cad
